# PostgreSQL bağlantısı (asyncpg)
DATABASE_URL=postgresql+asyncpg://fisly:fisly@localhost:5432/fisly

# JWT secret — production'da uzun, rastgele bir string ile değiştir
SECRET_KEY=change-me-in-production-min-32-chars

# Token süreleri
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Gemini Vision API key (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# Admin endpoint token (boşsa admin endpoint'ler devre dışı kalır)
ADMIN_TOKEN=

# Ücretsiz plan kullanıcısının aylık fiş tarama kotası
FREE_RECEIPT_QUOTA=30

# CORS — virgülle ayır. Production'da "*" YERINE specific domain'leri yaz.
# Örnek: CORS_ORIGINS=https://fisly.app,https://www.fisly.app
CORS_ORIGINS=*

# SMTP — boşsa e-postalar log'a yazılır (dev mode)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@fisly.app
SMTP_USE_TLS=true

# Şifre sıfırlama bağlantıları için public URL
APP_URL=https://fisly.app

# Sentry DSN (https://sentry.io)
SENTRY_DSN=
ENV=development

# Storage backend: local (dev, uploads/ klasörü) | r2 (production, Cloudflare R2)
STORAGE_BACKEND=local
# R2 ayarları (STORAGE_BACKEND=r2 ise zorunlu)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=fisly-receipts
# Presigned GET URL ömrü (saniye)
R2_URL_EXPIRE_SECONDS=3600

# RevenueCat webhook Authorization header secret (boşsa /billing/webhook 503 döner)
REVENUECAT_WEBHOOK_AUTH=
