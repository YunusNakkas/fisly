# Bu dosyayı `key.properties` olarak kopyala ve kendi değerlerinle doldur.
# key.properties repoya COMMIT EDİLMEZ (.gitignore'da).
#
# storeFile: keystore dosyasının yolu. Mutlak yol veya android/app dizinine göre relatif.
#   Öneri: keystore'u repo DIŞINDA tut (ör. ~/keys/fisly-upload.jks) ve mutlak yol ver.

storePassword=KEYSTORE_SIFRESI
keyPassword=KEY_SIFRESI
keyAlias=upload
storeFile=/Users/KULLANICI/keys/fisly-upload.jks
